// High-angle bearing spacer
// Tapered M3 spacer from ball pole at 5.7 to mounting face at 10 mm from centre.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

spacerProfile = sketch(on = XY) {
  slope = line(start = [var 0mm, var 1.9mm], end = [var 4.3mm, var 3mm])
  end = line(start = [var 4.3mm, var 3mm], end = [var 4.3mm, var 1.6mm])
  bore = line(start = [var 4.3mm, var 1.6mm], end = [var 0mm, var 1.6mm])
  startFace = line(start = [var 0mm, var 1.6mm], end = [var 0mm, var 1.9mm])
  coincident([slope.end, end.start])
  coincident([end.end, bore.start])
  coincident([bore.end, startFace.start])
  coincident([startFace.end, slope.start])
  vertical(end)
  horizontal(bore)
  vertical(startFace)
  horizontalDistance([ORIGIN, slope.start]) == 0mm
  verticalDistance([ORIGIN, slope.start]) == 1.9mm
  horizontalDistance([ORIGIN, slope.end]) == 4.3mm
  verticalDistance([ORIGIN, slope.end]) == 3mm
  verticalDistance([ORIGIN, bore.start]) == 1.6mm
}
spacerBlank = revolve(region(segments = [spacerProfile.slope, spacerProfile.end], intersectionIndex = -1, direction = CW), axis = X, angle = 360deg)
hide(spacerProfile)
spacer = appearance(spacerBlank, color = "#29292D")
