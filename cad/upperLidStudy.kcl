// Upper eyelid envelope
// Concentric shell study; pivot and linkage interfaces are not yet modeled.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import sphericalSector from "profiles.kcl"
import eyeRadius, lidRadialClearance, lidWall from "parameters.kcl"
upperLid = sphericalSector(outerRadius = eyeRadius + lidRadialClearance + lidWall, wall = lidWall, sweepAngle = 100deg)
  |> appearance(color = "#242424")
